# ==========================================
# RentScanner AI - Environment Configuration
# Nebius x NVIDIA Global AI Hackathon
# ==========================================

# Nebius Token Factory API Key (Inference API for NVIDIA Nemotron models)
# Get your key at: https://dev.nebius.com/builders or Token Factory console
VITE_NEBIUS_API_KEY=your_nebius_api_key_here
VITE_NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Preferred Nemotron Models on Nebius Token Factory:
# High-Reasoning Model (Fair-rent analysis, lease legal audit, negotiation):
VITE_NEBIUS_REASONING_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# Ultra-Fast Model (Query routing, intent extraction, real-time filtering):
VITE_NEBIUS_FAST_MODEL=nvidia/nemotron-mini-4b-instruct

# Tavily Search API Key (Real-time live web scraping of subleases & rental boards)
# Eligible for $3,000 "Best Use of Tavily" Prize!
# Get your free key at: https://tavily.com
VITE_TAVILY_API_KEY=your_tavily_api_key_here

# Enable Mock Fallback (true by default when API keys are empty)
# Allows teammates and judges to test full functionality out-of-the-box
VITE_ENABLE_MOCK_FALLBACK=true
