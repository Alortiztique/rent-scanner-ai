# ==========================================
# RentScanner AI - Environment Configuration
# Nebius x NVIDIA Global AI Hackathon
# ==========================================

# Nebius Token Factory API Key (Inference API for NVIDIA Nemotron models)
# Get your key at: https://dev.nebius.com/builders or Token Factory console
VITE_NEBIUS_API_KEY=your_nebius_api_key_here
VITE_NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Preferred Nemotron Models on Nebius Token Factory:
# High-Reasoning Model (Fair-rent analysis, lease legal audit, negotiation):
VITE_NEBIUS_REASONING_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# Ultra-Fast Model (Query routing, intent extraction, real-time filtering):
VITE_NEBIUS_FAST_MODEL=nvidia/nemotron-mini-4b-instruct

# Tavily Live Web Scout
# VITE_SCOUT_MODE is public (it is built into the browser bundle) and holds no secret:
#   demo    (default, also used when unset or blank) local labelled samples, no network request
#   server  POST to this site's own /api/scout. Live results need the owner's private Scout
#           Worker and Pages service binding (docs/scout-endpoint.md); until then the Scout
#           reports "unavailable", or "demo" if the Worker has no key. It never falls back.
# Any other value makes every Scout search report "unavailable".
VITE_SCOUT_MODE=demo
#
# Do not put a Tavily key in this file or in any VITE_ variable (including the old
# VITE_TAVILY_API_KEY): Vite copies VITE_ values into the public browser bundle, and the app
# no longer reads that variable. Server-only values live in the private Scout Worker, not here:
#   TAVILY_API_KEY        secret, set with `wrangler secret put` (see docs/scout-endpoint.md)
#   SCOUT_ALLOWED_ORIGIN  exact production origin, configured on the Worker

# Enable Mock Fallback (true by default when API keys are empty)
# Allows teammates and judges to test full functionality out-of-the-box
VITE_ENABLE_MOCK_FALLBACK=true

# Telegram Alert Bot Configuration (server-side Python only)
# Never add a VITE_ variable for the bot token. Web sign-up opens the Telegram bot;
# the browser only renders local sample previews and does not perform delivery.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
